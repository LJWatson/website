---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
---
{
"name": {{ site.name | json | safe }},
"short_name": {{ site.name | json | safe }},
"description": {{ site.metaDesc | json | safe }},
"start_url": "/",
"scope": "/",
"display": "standalone",
"background_color": "#F5F3FF",
"theme_color": "#6D28D9",
"lang": {{ site.lang | json | safe }},
"icons": [
{ "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png" },
{ "src": "/images/icon-512.png", "sizes": "512x512", "type": "image/png" },
{ "src": "/images/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
]
}
